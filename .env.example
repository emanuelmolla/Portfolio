# Copy to .env.local and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------- database ---

# MongoDB Atlas connection string.
# Same cluster as v1: the Blog/Message/Visit data is migrated in place.
# Until this is set the site runs off lib/content/_seed.ts and the admin can
# read nothing and save nothing, which it says on every screen.
MONGODB_URI=

# ------------------------------------------------------------------- admin ---

# Signing key for the session cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Who is allowed in. Comma separated, case insensitive.
# Several addresses on purpose, so losing access to one account is an
# inconvenience rather than a lockout.
#
# An EMPTY list denies everyone. That is deliberate: treating "unset" as
# "allow all" would turn one missing variable into a public admin.
ADMIN_EMAILS=

# Read as well, so an older environment keeps working. ADMIN_EMAILS is the one
# to use.
ADMIN_EMAIL=

# --- Google OAuth ------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#
# Authorised redirect URIs must include BOTH, exactly:
#   http://localhost:3000/api/auth/callback/google
#   https://emanuelmolla.dev/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- GitHub OAuth (optional) -------------------------------------------------
# github.com/settings/developers -> New OAuth App
# Callback URL: <origin>/api/auth/callback/github
#
# A provider is only registered when both of its variables are present, so
# leaving these empty simply means no GitHub button. It does not break Google.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ------------------------------------------------------------- revalidation ---

# Shared secret for the on-demand revalidation route handler, so only the admin
# can trigger a rebuild of cached pages.
#
# Not needed for editing: saving in the admin calls updateTag() directly inside
# the server action. This is for triggering a refresh from outside the app.
REVALIDATE_SECRET=

# ------------------------------------------------------------------- email ---
# Resend. Notifies you when someone uses the contact form.
#
# Messages are stored whether or not this is configured: the notification is a
# convenience, never a dependency. Without it, messages only appear in the admin.

# resend.com/api-keys
RESEND_API_KEY=

# Must be on a domain VERIFIED in Resend. Resend rejects anything else, which is
# the correct behaviour. Not the visitor's address: that goes in reply_to, so
# hitting Reply in your mail client reaches them directly.
CONTACT_FROM_EMAIL="Portfolio <site@emanuelmolla.dev>"

# Where notifications land. Falls back to the first address in ADMIN_EMAILS.
CONTACT_TO_EMAIL=
