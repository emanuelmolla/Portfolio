# Copy to .env.local and fill in. Never commit the filled-in file.

# MongoDB Atlas connection string.
# Same cluster as v1: the Blog/Message/Visit data is migrated in place.
MONGODB_URI=

# Admin access. NextAuth with Google, allow-listed to a single address:
# there is no user table and no sign-up, by design.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL=

# Shared secret for the on-demand revalidation route handler, so only the admin
# can trigger a rebuild of cached pages.
REVALIDATE_SECRET=
